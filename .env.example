# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API.
#
# Leave both empty to run the app in DEMO MODE: everything works in the
# browser with sample data, and you can preview each role from the login page.

VITE_SUPABASE_URL=https://iutzevoosrxaibzuhkbv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_Ehr7vnxBiNik6m0fxOZVNw_9fLm_lNU

# Optional: maps. The church maps open on SATELLITE (Esri World Imagery with
# Esri place/road labels) and can switch to the STREET map (OpenStreetMap).
# Leave these empty to use those defaults. To use another provider (e.g. MapTiler,
# which needs a free key), paste its tile URL and attribution here.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=
# Only used with a custom satellite URL: an optional transparent labels layer.
VITE_SATELLITE_LABELS_URL=

# NEVER put the Supabase service_role key in this app.
